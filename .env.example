# Copy to .env and edit. Every setting is optional.

# Shown on every page.
TTGEN_ORG_NAME=PSG College of Technology

# Create this administrator on first start if no account exists yet.
# Otherwise open the site and create one on the first-run screen.
# Change the password after signing in.
#TTGEN_ADMIN_USERNAME=timetable.office
#TTGEN_ADMIN_PASSWORD=change-me-please

# How long a sign-in lasts, in hours.
TTGEN_SESSION_HOURS=12

# Set to 1 once the site is served over HTTPS (cookies then never travel in clear).
TTGEN_SECURE_COOKIES=0
